[Unit]
Description=Back up databases, sealing keys and media
Wants=network-online.target
After=network-online.target docker.service k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/backup
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
